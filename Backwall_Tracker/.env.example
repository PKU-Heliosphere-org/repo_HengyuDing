# Application
APP_NAME=后墙 Backwall Tracker
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
LOG_LEVEL=INFO
TIMEZONE=Asia/Shanghai

# Security (replace before any non-local deployment)
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# PostgreSQL / SQLAlchemy
POSTGRES_DB=backwall
POSTGRES_USER=backwall
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional full override. URL-encode reserved characters if this is used.
DATABASE_URL=

# File storage
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=50

# OCR and large-model adapters. External transfer is disabled by default.
OCR_PROVIDER=disabled
LLM_PROVIDER=disabled
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_ALLOW_EXTERNAL=false

# Container-exposed ports
WEB_PORT=8080
